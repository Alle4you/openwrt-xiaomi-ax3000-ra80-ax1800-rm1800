From 0c9a65dbc17a3e3cb45a0a78133ce1d28bfd73a5 Mon Sep 17 00:00:00 2001
From: Alle4you <56454046+Alle4you@users.noreply.github.com>
Date: Fri, 30 Oct 2026 08:59:07 -0300
Subject: [PATCH 3/4] qualcommax: ipq60xx: xiaomi ax1800: use the 256 MB memory
 layout

The AX1800 has 256 MB of RAM but used the 512 MB layout: FW memory
mode 1 with a 55 MB q6_region and a 16 MB nss_region, leaving about
157 MB to Linux.

Use the layout of the stock firmware instead, taken from its device
tree (QSDK 256M profile): FW memory mode 2, a 40 MB q6_region, an
8 MB nss_region and the 3 MB Q6 ETR dump area right after q6_region
kept reserved. The firmware sizes its own memory from the mode, so the
mode and the region size must change together.

Reserved memory goes from 81 MB to 61 MB.

Signed-off-by: Alle4you <56454046+Alle4you@users.noreply.github.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0131p3ppZXaVqXxtupLrRC2P
---
 .../boot/dts/qcom/ipq6000-xiaomi-ax1800.dts   | 21 +++++++++++++++++--
 1 file changed, 19 insertions(+), 2 deletions(-)

diff --git a/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq6000-xiaomi-ax1800.dts b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq6000-xiaomi-ax1800.dts
index 1d25528780..a244fec3e4 100644
--- a/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq6000-xiaomi-ax1800.dts
+++ b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq6000-xiaomi-ax1800.dts
@@ -2,7 +2,7 @@
 
 /dts-v1/;
 
-#include "ipq6018-512m.dtsi"
+#include "ipq6018.dtsi"
 #include "ipq6018-ess.dtsi"
 
 #include <dt-bindings/gpio/gpio.h>
@@ -32,6 +32,14 @@
 		reg = <0x0 0x40000000 0x0 0x10000000>;
 	};
 
+	reserved-memory {
+		/* Q6 ETR dump and reserved blocks placed after q6_region by the stock firmware */
+		memory@4d300000 {
+			reg = <0x0 0x4d300000 0x0 0x300000>;
+			no-map;
+		};
+	};
+
 	keys {
 		compatible = "gpio-keys";
 
@@ -333,5 +341,14 @@
 	status = "okay";
 
 	qcom,ath11k-calibration-variant = "Xiaomi-AX1800";
-	qcom,ath11k-fw-memory-mode = <1>;
+	qcom,ath11k-fw-memory-mode = <2>;
+};
+
+/* 256 MB layout, same as the stock firmware (FW memory mode 2) */
+&nss_region {
+	reg = <0x0 0x40000000 0x0 0x800000>;
+};
+
+&q6_region {
+	reg = <0x0 0x4ab00000 0x0 0x2800000>;
 };
