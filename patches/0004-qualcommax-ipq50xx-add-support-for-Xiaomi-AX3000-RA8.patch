 	wallys_dr40x9 \
 	xiaomi_aiot-ac2350 \
 	xiaomi_ax1800 \
+	xiaomi_ax3000 \
 	xiaomi_ax3600 \
 	xiaomi_ax6000 \
 	xiaomi_ax9000 \
@@ -276,6 +277,7 @@ $(eval $(call generate-ipq-wifi-package,tplink_tl-wa1201-v2,TP-Link TL-WA1201 V2
 $(eval $(call generate-ipq-wifi-package,wallys_dr40x9,Wallys DR40X9))
