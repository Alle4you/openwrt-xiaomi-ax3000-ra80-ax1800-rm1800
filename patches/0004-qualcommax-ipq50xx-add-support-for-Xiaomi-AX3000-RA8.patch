@@ -211,6 +211,22 @@ platform_do_upgrade() {
 		remove_oem_ubi_volume ubi_rootfs
 		nand_do_upgrade "$1"
 		;;
+	xiaomi,ax3000)
+		# OpenWrt always goes to the first slot (rootfs): the stock
+		# firmware stays untouched in rootfs_1 as a fallback
+		CI_UBIPART="rootfs"
+		remove_oem_ubi_volume ubi_rootfs
+		fw_setenv -s - <<-EOF
+			boot_wait on
+			uart_en 1
+			flag_boot_rootfs 0
+			flag_last_success 0
+			flag_boot_success 1
+			flag_try_sys1_failed 0
+			flag_try_sys2_failed 0
+		EOF
+		nand_do_upgrade "$1"
+		;;
 	xiaomi,ax6000)
 		# Make sure that UART is enabled
 		fw_setenv boot_wait on
